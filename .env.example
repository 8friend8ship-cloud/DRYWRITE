# Google AdSense monetization.
# Set only after the verified publisher ID is confirmed for this deployed site.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_EXCLUDED_PATHS=/login,/settings,/privacy,/terms,/api

# Public Bots front URL used by the language/bot bridge.
# Do not put API keys, access tokens, or private Apps Script URLs here.
# Example after the canonical Bots front is runtime-verified:
# VITE_BOTS_FRONT_URL=https://bots.example.com
VITE_BOTS_FRONT_URL=
